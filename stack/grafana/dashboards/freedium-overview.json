        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(freedium_jxl_conversion_total{outcome='success'}[1m]))*60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        }
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "JXL conversion rate",
      "gridPos": {
        "x": 6,
        "y": 68,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(freedium_jxl_conversion_total{outcome='success'}[5m]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(freedium_jxl_conversion_total{outcome='cjxl_error'}[5m]))",
          "legendFormat": "cjxl_error",
          "refId": "B"
        },
        {
          "expr": "sum(rate(freedium_jxl_conversion_total{outcome='cjxl_timeout'}[5m]))",
          "legendFormat": "cjxl_timeout",
          "refId": "C"
        },
        {
          "expr": "sum(rate(freedium_jxl_conversion_total{outcome='size_anomaly'}[5m]))",
          "legendFormat": "size_anomaly",
          "refId": "D"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "JXL serve format split",
      "gridPos": {
        "x": 18,
        "y": 68,
        "w": 6,
        "h": 8
      },
      "datasource": {
