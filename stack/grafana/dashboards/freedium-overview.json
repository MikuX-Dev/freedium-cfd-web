              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 25,
      "type": "logs",
      "title": "JXL conversion errors",
      "gridPos": {
        "x": 0,
        "y": 76,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{container=\"freedium-worker\"} |= \"jxl conversion\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Image serve format (stacked, per min)",
      "gridPos": {
        "x": 0,
        "y": 84,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(freedium_image_serve_total{format='png'}[1m]))*60",
          "legendFormat": "PNG (raw)",
          "refId": "A"
        },
        {
          "expr": "sum(rate(freedium_image_serve_total{format='jpeg'}[1m]))*60",
          "legendFormat": "JPEG (raw)",
          "refId": "B"
        },
        {
          "expr": "sum(rate(freedium_image_serve_total{format='gif'}[1m]))*60",
          "legendFormat": "GIF (raw)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(freedium_image_serve_total{format='jxl_native'}[1m]))*60",
          "legendFormat": "JXL native",
          "refId": "D"
        },
        {
          "expr": "sum(rate(freedium_image_serve_total{format='jxl_fallback'}[1m]))*60",
          "legendFormat": "JXL\u2192JPEG fallback",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        }
      }
    },
    {
      "id": 27,
      "type": "piechart",
      "title": "Image serve distribution (1h)",
      "gridPos": {
        "x": 0,
        "y": 94,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
